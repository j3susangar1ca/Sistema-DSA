# ==============================================================================
# Sistema-DSA: Git Ignore Configuration (ISO Standard Compliance)
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Log & Diagnostic files
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Rust compilation artifacts
/target/
**/*.rs.bk
Cargo.lock

# Python & virtual environment artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/
env/
dist/
build/
*.egg-info/

# SQLite Databases & WAL (Edge Persistence Buffer)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Microsoft Office backup / locking files & raw data
~$*.xlsx
~$*.docx
~$*.pptx
*.csv
/data/

# Credentials, keys & environment configurations
.env
.env.*
*.pem
*.key
*.crt
*secret*.json
*credentials*.json
*key*.json
oauth2.txt
